# Normalise line endings so a Windows checkout and a Linux CI runner produce the
# same blob. Without this, files committed from Windows arrive at the build with
# CRLF and shell scripts inside the image fail with a confusing "not found".
* text=auto eol=lf

*.sln text eol=crlf
*.cs text diff=csharp
*.csproj text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.pdf binary
